        [ a :Role ;
            rdfs:label "Deputado na VI Legislatura (1991-1995) - Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias, de Juventude, de Revisão Constitucional e de Inquérito ao Acidente de Camarate. Membro da Direcção do Grupo Parlamentar do PCP."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na IX Legislatura (2002-2005). Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias, de Defesa Nacional, da Comissão de Revisão Constitucional e da Comissão para a Reforma do Sistema Político. Membro da delegação da A.R. à Assembleia Parlamentar da OSCE. Membro do Conselho de Direcção do Canal Parlamento. Vice-Presidente da Grupo Parlamentar do PCP. Vice-Presidente da Assembleia da República em 2004 e 2005."^^xsd:string ] ;
