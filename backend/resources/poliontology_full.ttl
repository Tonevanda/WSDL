        [ a :Role ;
            rdfs:label "Deputado na XII Legislatura (2011-2015) - Vice-Presidente da Assembleia da República: Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias e de Defesa Nacional. Presidente do Grupo Parlamentar de Amizade Portugal-Cuba."^^xsd:string ],
