            rdfs:label "10. Presidente da Associação Nacional dos Autarcas Socialistas entre o dia 04 de Janeiro de 2014 e o dia 23 de Outubro de 2015."^^xsd:string ],
        [ a :Role ;
            rdfs:label "13. Secretário de Estado das Comunidades Portuguesas entre 2015 e 2019."^^xsd:string ],
        [ a :Role ;
            rdfs:label "3. Chefe de Gabinete do Grupo Parlamentar do Partido Socialista entre 2000 e 2002."^^xsd:string ],
        [ a :Role ;
            rdfs:label "4. Em Fevereiro de 2005 foi eleito deputado à Assembleia da República. Integrou a Comissão dos Negócios Estrangeiros e foi eleito membro da Assembleia Parlamentar Euro-Mediterrânica."^^xsd:string ] ;
