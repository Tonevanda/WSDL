    :role [ a :Role ;
            rdfs:label "Deputado na XIII Legislatura (2015-2019) - Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias e de Defesa Nacional; Presidente do Grupo Parlamentar de Amizade Portugal-Cuba."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na V Legislatura entre 1989 e 1991. Membro das Comissões Parlamentares de Educação, Ciência e Cultura, de Juventude e do Inquérito ao Fundo Social Europeu. Presidente da Comissão de Inquérito ao Centro Cultural de Belém. Membro da Direcção do Grupo Parlamentar do PCP."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Membro da Direcção da Juventude Comunista Portuguesa(1986-1995)"^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na XIV Legislatura (2019-2022). Vice-Presidente da Assembleia da República. Membro da Comissão de Assuntos Constitucionais, Direitos, Liberdades e Garantias. Presidente do Grupo Parlamentar de Amizade Portugal-Cuba. Vice-Presidente do Grupo Parlamentar do PCP."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na VII Legislatura (1995-1999) - Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias, de Ética, de Revisão Constitucional, de Inquérito aos Grupos Economicos e ao Acidente de Camarate. Presidente da Comissão Eventual para a Toxicodependência. Membro do Conselho de Administração da A.R.. Membro do Conselho Directivo do Grupo Português da União Interparlamentar. Membro da Direcção do Grupo Parlamentar do PCP."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na VI Legislatura (1991-1995) - Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias, de Juventude, de Revisão Constitucional e de Inquérito ao Acidente de Camarate. Membro da Direcção do Grupo Parlamentar do PCP."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na XIII Legislatura (2015-2019) - Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias e de Defesa Nacional; Presidente do Grupo Parlamentar de Amizade Portugal-Cuba."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Vereador da Câmara Municipal da Amadora (2002)"^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na XIV Legislatura (2019-2022). Vice-Presidente da Assembleia da República. Membro da Comissão de Assuntos Constitucionais, Direitos, Liberdades e Garantias. Presidente do Grupo Parlamentar de Amizade Portugal-Cuba. Vice-Presidente do Grupo Parlamentar do PCP."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Membro da Assembleia Municipal de Sintra entre 2005 e 2017."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na VII Legislatura (1995-1999) - Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias, de Ética, de Revisão Constitucional, de Inquérito aos Grupos Economicos e ao Acidente de Camarate. Presidente da Comissão Eventual para a Toxicodependência. Membro do Conselho de Administração da A.R.. Membro do Conselho Directivo do Grupo Português da União Interparlamentar. Membro da Direcção do Grupo Parlamentar do PCP."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Membro da Direcção da Juventude Comunista Portuguesa(1986-1995)"^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na V Legislatura entre 1989 e 1991. Membro das Comissões Parlamentares de Educação, Ciência e Cultura, de Juventude e do Inquérito ao Fundo Social Europeu. Presidente da Comissão de Inquérito ao Centro Cultural de Belém. Membro da Direcção do Grupo Parlamentar do PCP."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Membro da Direcção do Conselho Nacional de Juventude(1986)"^^xsd:string ],
        [ a :Role ;
            rdfs:label "Vereador da Câmara Municipal da Amadora (2002)"^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na X Legislatura (2005-2009) - Vice-Presidente da Assembleia da República. Vice-Presidente da Comissão Parlamentar de Assuntos Constitucionais, Direitos, Liberdades e Garantias. Membro da Comissão de Defesa Nacional. Membro do Conselho de Direcção do Canal Parlamento. Vice-Presidente do Grupo Parlamentar do PCP."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na IX Legislatura (2002-2005). Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias, de Defesa Nacional, da Comissão de Revisão Constitucional e da Comissão para a Reforma do Sistema Político. Membro da delegação da A.R. à Assembleia Parlamentar da OSCE. Membro do Conselho de Direcção do Canal Parlamento. Vice-Presidente da Grupo Parlamentar do PCP. Vice-Presidente da Assembleia da República em 2004 e 2005."^^xsd:string ],
        [ a :Role ;
            rdfs:label "Membro do Comité Central do PCP;"^^xsd:string ],
        [ a :Role ;
            rdfs:label "Deputado na XII Legislatura (2011-2015) - Vice-Presidente da Assembleia da República: Membro das Comissões Parlamentares de Assuntos Constitucionais, Direitos, Liberdades e Garantias e de Defesa Nacional. Presidente do Grupo Parlamentar de Amizade Portugal-Cuba."^^xsd:string ],
        [ a :Role ;
